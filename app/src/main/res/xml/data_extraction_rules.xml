<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
        Solo incluimos el archivo de recuperación de emergencia.
        Android automáticamente excluye los archivos no listados.
        Las SharedPreferences encriptadas se omiten intencionalmente
        porque están ligadas al hardware del dispositivo original.
        disableIfNoEncryptionCapabilities garantiza cifrado en nube.
    -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="backup_local_invisible.dat" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="backup_local_invisible.dat" />
    </device-transfer>
</data-extraction-rules>